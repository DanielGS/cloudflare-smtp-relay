
# =============================================================================
# cloudflare-smtp-relay
#
# Copy this file to .env and fill in the blanks:
#     cp .env.example .env
#
# Every value below is read at startup. The relay validates all of them at once
# and refuses to start listing every problem it found, so a broken .env tells
# you everything that is wrong in a single run.
# =============================================================================


# -----------------------------------------------------------------------------
# SMTP listener: the side your applications talk to
# -----------------------------------------------------------------------------

# Interface the SMTP server binds to. Keep 0.0.0.0 so other containers on the
# Docker network can reach it. It is not exposed to the host unless you
# uncomment the ports section in docker-compose.yml.
SMTP_HOST=0.0.0.0

# Port for SMTP submission. 2525 avoids the privileged range, so the process
# does not need root to bind it.
SMTP_PORT=2525

# Username your applications authenticate with. This is a credential the relay
# invents for itself; it has nothing to do with your Cloudflare account.
SMTP_USER=relay

# Password for the above. AUTH is mandatory: without valid credentials the relay
# refuses MAIL FROM, so it can never act as an open relay for anything that
# reaches the network. Change this value.
SMTP_PASSWORD=change-me

# Largest message the relay will accept, in bytes. 5 MiB is Cloudflare's own
# cap, and the relay refuses to start if you set it higher, because a larger
# message would only be rejected upstream after being transferred for nothing.
# Anything over the limit is refused with SMTP 552.
SMTP_MAX_MESSAGE_BYTES=5242880

# Maximum RCPT TO commands per transaction. 50 is Cloudflare's combined cap
# across to, cc and bcc; the relay refuses to start above it.
SMTP_MAX_RECIPIENTS=50

# How long the server waits for the next line from a client before dropping an
# idle connection. Prevents a stalled application from holding a slot forever.
SMTP_READ_TIMEOUT=30s

# How long the server waits when writing a response to a client that has stopped
# reading.
SMTP_WRITE_TIMEOUT=30s

# Optional TLS certificate for the SMTP port. Leave empty on a private Docker
# network, where the traffic never leaves the host and plaintext is the intended
# setup. Set it only if the relay becomes reachable beyond that network.
SMTP_TLS_CERT=

# Private key matching SMTP_TLS_CERT. Both must be set together or both left
# empty; setting only one is a startup error.
SMTP_TLS_KEY=


# -----------------------------------------------------------------------------
# Cloudflare transport: the side that actually delivers
# -----------------------------------------------------------------------------

# Which upstream the relay delivers through.
#
#   rest    -> Cloudflare's Email Sending REST API, called directly.
#   worker  -> your own Worker holding the Email Routing send_email binding.
#
# Run the probe in the README to find out which one your account allows. If the
# probe returns 403 with 10105 or 10203, the REST surface is gated behind the
# Workers Paid plan and you need "worker".
CLOUDFLARE_TRANSPORT=rest

# Your Cloudflare account identifier, required when CLOUDFLARE_TRANSPORT=rest.
# Find it in the dashboard URL (dash.cloudflare.com/<this>/...), in the Overview
# sidebar of any of your domains, or with `npx wrangler whoami`. Take the
# Account ID, not the Zone ID. It is not a secret.
CLOUDFLARE_ACCOUNT_ID=

# API token with the "Email Sending: Edit" permission, required when
# CLOUDFLARE_TRANSPORT=rest. This IS a secret: it authorizes sending on your
# behalf. The relay never writes it to a log and never bakes it into the image.
CLOUDFLARE_API_TOKEN=

# Base URL of the Cloudflare API. Only change it to point the relay at a stand-in
# server during testing; the default is correct for production.
CLOUDFLARE_API_BASE_URL=https://api.cloudflare.com/client/v4

# Time budget for a single HTTP attempt against Cloudflare, not for the whole
# retry sequence. On expiry the client gets SMTP 451 so it retries later.
CLOUDFLARE_TIMEOUT=15s

# Extra attempts after the first one, for temporary failures only: rate limits,
# upstream 5xx and network errors. A permanent rejection is never retried, and
# neither is an authentication failure, since a wrong token will not fix itself
# between attempts. Keep this small: the relay has no persistent queue.
CLOUDFLARE_MAX_RETRIES=2

# URL of your deployed Worker. Required when CLOUDFLARE_TRANSPORT=worker,
# ignored otherwise. See worker/README.md for how to deploy it.
WORKER_URL=

# Shared secret the relay presents to your Worker as a bearer token, so nobody
# else can post messages to it. Required when CLOUDFLARE_TRANSPORT=worker.
# Generate one with `openssl rand -hex 32` and set the same value on the Worker
# with `npx wrangler secret put RELAY_SECRET`. This IS a secret and is never
# logged.
WORKER_SECRET=


# -----------------------------------------------------------------------------
# Sender policy
# -----------------------------------------------------------------------------

# Comma-separated list of domains allowed in MAIL FROM. Leave empty to accept
# any sender. When set, anything else is refused with SMTP 550 before the
# message body is even transferred, which stops a compromised container on the
# network from sending as an unrelated domain.
#
# Matching is EXACT on the domain: "subdomain.mydomainexample.com" does not permit
# "mydomainexample.com" and does not permit "evil-subdomain.mydomainexample.com".
ALLOWED_FROM_DOMAINS=subdomain.mydomainexample.com


# -----------------------------------------------------------------------------
# Health endpoint
# -----------------------------------------------------------------------------

# Interface the health server binds to. Serves GET /health returning
# {"status":"ok"} and nothing else: it exposes no configuration and no
# credentials.
HEALTH_HOST=0.0.0.0

# Port for the health endpoint. The container HEALTHCHECK probes this port
# through the binary itself, because the distroless image has no shell or curl.
HEALTH_PORT=8080


# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------

# Verbosity: debug, info, warn or error.
#
# One structured JSON record is emitted per handled message, carrying the
# internal message id, sender, recipients, truncated subject, outcome, duration,
# upstream status and attempt count. Message bodies, passwords and tokens are
# never logged at any level, including debug.
LOG_LEVEL=info
